# odditimana.com の設定
# このフォルダの下にあるサブドメインのフォルダにも、.htaccess の設定は引き継がれる。
# サブドメインのサイトの動きを変えないよう、転送・404・圧縮・キャッシュは
# odditimana.com と www.odditimana.com へのアクセスだけに効かせる。

# サーバーの管理画面が書いた設定（XML-RPC の国外からのアクセス制限を外す）。
# サブドメインの WordPress にも効いているので、そのまま残す。
SetEnvIf Request_URI ".*" AllowXmlrpc

# URL を https://odditimana.com/ の形に揃える（301 は恒久的な転送）
<IfModule mod_rewrite.c>
  RewriteEngine On

  # index.html 付きで来たアクセスを、index.html の無い URL に揃える（/about/index.html → /about/）。
  # 判断には、ブラウザが実際に要求した URL（THE_REQUEST）を使う。
  # /about/ を開いたときにサーバーの中で index.html に読み替えた分には反応しないので、転送がくり返されない
  RewriteCond %{HTTP_HOST} ^(www\.)?odditimana\.com$ [NC]
  RewriteCond %{THE_REQUEST} ^[A-Z]+\s(/(?:[^?\s]*/)?)index\.html[?\s]
  RewriteRule ^ https://odditimana.com%1 [R=301,L]

  # http と www 付きのアクセスを https://odditimana.com/ に揃える
  RewriteCond %{HTTP_HOST} ^(www\.)?odditimana\.com$ [NC]
  RewriteCond %{HTTPS} !on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://odditimana.com%{REQUEST_URI} [R=301,L]
</IfModule>

<If "%{HTTP_HOST} =~ /^(www\.)?odditimana\.com$/i">
  # 存在しない URL では 404.html を表示する
  ErrorDocument 404 /404.html

  # HTML・CSS・JS・SVG を圧縮して送る
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript image/svg+xml
  </IfModule>

  # ブラウザが保存しておく期間
  <IfModule mod_expires.c>
    ExpiresActive On
    # HTML：毎回、更新されていないかを確かめる
    ExpiresByType text/html "access plus 0 seconds"
    # CSS・JS：1日
    ExpiresByType text/css "access plus 1 day"
    ExpiresByType text/javascript "access plus 1 day"
    ExpiresByType application/javascript "access plus 1 day"
    # 画像：1か月
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    # フォント：1年
    ExpiresByType font/woff2 "access plus 1 year"
  </IfModule>
</If>
